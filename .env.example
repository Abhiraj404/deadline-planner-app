# Deadline Planner configuration template.
# setup.ps1 copies this file to .env. Never commit .env: it can contain private URLs.
# Every integration is optional. Leave a value empty to disable it.
# You can also edit these values on the Setup page of the running planner.

# Moodle site address, or a signed-in page such as your dashboard.
MOODLE_URL=
# Private calendar subscription URL from Moodle: Calendar > Export calendar.
# Treat it like a password: it grants read access to your calendar.
MOODLE_ICS_URL=
# IANA timezone used to convert calendar times, for example Europe/Dublin.
MOODLE_TIMEZONE=

# Microsoft Entra application (client) ID for read-only Outlook mail access.
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT=common

# Minutes between automatic syncs. Saved settings in the app take precedence.
SYNC_MINUTES=30
PLANNER_LOG_LEVEL=INFO

# Optional local OCR for scanned PDFs. Requires pdftoppm (Poppler) and tesseract
# on PATH. Nothing is sent to an online service.
PLANNER_DOCUMENT_OCR=false
# PLANNER_DOCUMENT_MAX_TEXT_CHARS=100000
# PLANNER_DOCUMENT_MAX_PDF_PAGES=200

# Port used by start.ps1 / run_server.py. The server always binds to 127.0.0.1.
# PLANNER_PORT=8000
